# Interface to bind the HTTP server to (default 0.0.0.0 = all interfaces).
# Set to an internal IP (e.g. WireGuard) to keep the service off public interfaces.
HOST=0.0.0.0
PORT=8000

# Shared Redis with main-backend — prompt cache, profile cache, request dedupe.
# MUST be the SAME instance main-backend writes profile:{id}/prompt:{id} to,
# otherwise profile-save cache invalidation will not reach ai-backend (stale
# profile up to 5min, stale compiled prompt up to 24h).
# Include credentials if main-backend's Redis is password-protected.
# Format: redis://username:password@host:port
REDIS_URL=redis://default:password@localhost:6379

# Shared Redis with main-backend — BullMQ job queue (same instance as REDIS_URL)
BULLMQ_REDIS_URL=redis://default:password@localhost:6379

# main-backend internal API — cold cache profile fetch on Redis miss
MAIN_BACKEND_INTERNAL_URL=http://localhost:3000

# Single shared secret — same value as AI_INTERNAL_API_TOKEN in main-backend .env
# Covers both directions: sent to main-backend (cold cache) and checked by InternalTokenGuard
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIN_BACKEND_INTERNAL_TOKEN=

OPENROUTER_API_KEY=

OPENROUTER_MODEL=anthropic/claude-haiku-4.5

USE_MULTI_MODEL_PIPELINE=true

PIPELINE_TRIAGE_MODEL=anthropic/claude-haiku-4.5
PIPELINE_GENERATOR_MODEL=anthropic/claude-sonnet-4-6
PIPELINE_GENERATOR_MODEL_HIGH_VALUE=anthropic/claude-opus-4-7
PIPELINE_VALIDATOR_MODEL=anthropic/claude-haiku-4.5

# Model for the internal hourly digest (ai.digest queue). Leave empty to reuse
# PIPELINE_GENERATOR_MODEL. The digest summarises counters for the business
# owner — never a customer — so a cheaper tier is usually the right call.
PIPELINE_DIGEST_MODEL=anthropic/claude-haiku-4.5

# Model for the digest assistant (POST /ai/v1/assistant/stream): the owner asks
# follow-up questions about a digest and it answers from read-only tools. Leave
# empty to reuse PIPELINE_GENERATOR_MODEL.
PIPELINE_ASSISTANT_MODEL=anthropic/claude-haiku-4.5

PIPELINE_TRIAGE_TIMEOUT_MS=4500
PIPELINE_GENERATOR_TIMEOUT_MS=10000
PIPELINE_VALIDATOR_TIMEOUT_MS=4500
PIPELINE_DIGEST_TIMEOUT_MS=20000
# One streamed assistant pass. A turn makes up to 6 passes (5 tool rounds + a final answer).
PIPELINE_ASSISTANT_TIMEOUT_MS=30000

PIPELINE_MAX_RETRIES=1

# When true, skip the validator LLM call on low-risk turns (greetings, meta and
# grounded factual/process answers with no price/closing/medical/complaint/handoff
# signal). Saves one Haiku call on those turns; the cheap local tone+safety checks
# still run. Default false = validate every turn (safest). See
# docs/AI_PIPELINE_OPTIMIZATION_WORKLOG.md (Phase 3, item 3.4).
PIPELINE_VALIDATE_RISKY_ONLY=false

# Hard wall-clock budget for one ai.reply job in the worker. Keep it ≥
# triage + (generator + validator) × (PIPELINE_MAX_RETRIES + 1) + headroom.
# 45s suits the fast Claude tier above; raise it substantially (e.g. 90000) when
# pointing the pipeline at slower OpenRouter models, or valid turns get killed
# mid-flight and surface as job_timeout on both backends.
WORKER_JOB_TIMEOUT_MS=45000

# Wall-clock budget for one ai.digest job — a single JSON call plus parsing, so
# far less headroom than a reply turn needs.
DIGEST_JOB_TIMEOUT_MS=30000

# Wall-clock budget for one whole digest-assistant turn (every pass and tool call).
# Keep it under main-backend's 120s relay timeout.
ASSISTANT_TURN_TIMEOUT_MS=90000
